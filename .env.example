# ==============================================================================
# VICTOR V1 environment variables
#
# All AI provider credentials are BACKEND-ONLY and MUST NEVER be exposed to the
# Web_Client or included in any response returned to the client (Requirement 5.5).
# Copy this file to `.env` and fill in real values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (Database + Auth)
# ------------------------------------------------------------------------------
# Public URL of the Supabase project. Safe to expose to the frontend.
SUPABASE_URL=https://your-project.supabase.co
# Anonymous/public key. Used by the Web_Client for auth. Safe to expose.
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key. BACKEND ONLY. Grants full DB access. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend-visible Supabase config (Next.js public env, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# AI Provider credentials (BACKEND ONLY - never sent to the Web_Client)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Default models per provider (must match the backend allow-list).
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# Rate limiting (per Authenticated_User_Id, Requirement 9.2)
# ------------------------------------------------------------------------------
# Time window in seconds for the rate limit bucket.
RATE_LIMIT_TTL_SECONDS=60
# Maximum requests allowed within the TTL window for rate-limited endpoints.
RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# Backend server
# ------------------------------------------------------------------------------
PORT=3001
# Origin allowed for CORS (the Web_Client origin).
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# Base URL the Web_Client uses to reach the Backend_API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
